{
  "name": "@legacyhosting/api",
  "version": "1.0.36",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=9.2.0",
    "pnpm": ">=12.4.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/core/database/migrate.ts",
    "certificates:worker": "tsx src/workers/certificate-renewal.ts",
    "monitoring:worker": "tsx src/workers/monitoring.ts",
    "test": "tsx --test tests/*.test.ts",
    "check:migrations": "tsx --test tests/migrations.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "9.0.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@simplewebauthn/server": "14.0.2",
    "dotenv": "18.0.3",
    "fastify": "5.12.5",
    "fastify-raw-body": "6.0.1",
    "jose": "6.2.12",
    "mysql2": "3.24.4",
    "openid-client": "6.8.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
