NODE_ENV=development
HOST=0.0.0.0
PORT=8080
PANEL_ORIGIN=http://localhost:5173
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
ALLOW_LEGACY_AGENT_SIGNATURES=true
DATABASE_URL=mysql://legacyhosting:password@host:25060/legacyhosting?ssl-mode=REQUIRED
DATABASE_SSL_CA=/path/to/digitalocean-mysql-ca.pem
SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
WEBAUTHN_RP_NAME=Legacy Hosting
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
INITIAL_ADMIN_TOKEN=replace-with-a-long-one-time-bootstrap-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
CSRF_SECRET=replace-with-at-least-32-random-characters
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_REDIRECT_URI=https://api.legacyhosting.xyz/api/v1/integrations/cloudflare/callback
CLOUDFLARE_OAUTH_API_ORIGIN=https://api.cloudflare.com
CLOUDFLARE_OAUTH_TOKEN_AUTH_METHOD=client_secret_basic
CLOUDFLARE_OAUTH_SCOPES=dns.read dns.write zone.read user-details.read offline_access
ACME_EMAIL=angel@legacyhosting.xyz
CERTIFICATE_RENEWAL_DAYS=30
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_VERSION=2026-03-10
MONITORING_INTERVAL_MS=30000
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@legacyhosting.xyz
